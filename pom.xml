<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <groupId>app.tuxguitar.plugins</groupId>
  <artifactId>tuxguitar-capo</artifactId>
  <version>1.0.0</version>
  <name>Capo Settings</name>
  <properties>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <maven.compiler.release>9</maven.compiler.release>
    <!-- The upstream 2.0.1 tag retains this Maven version. Build only the pinned tag. -->
    <tuxguitar.api.version>9.99-SNAPSHOT</tuxguitar.api.version>
  </properties>
  <dependencies>
    <dependency><groupId>app.tuxguitar</groupId><artifactId>tuxguitar</artifactId><version>${tuxguitar.api.version}</version><scope>provided</scope></dependency>
    <dependency><groupId>app.tuxguitar</groupId><artifactId>tuxguitar-lib</artifactId><version>${tuxguitar.api.version}</version><scope>provided</scope></dependency>
    <dependency><groupId>app.tuxguitar</groupId><artifactId>tuxguitar-editor-utils</artifactId><version>${tuxguitar.api.version}</version><scope>provided</scope></dependency>
    <dependency><groupId>app.tuxguitar</groupId><artifactId>tuxguitar-ui-toolkit</artifactId><version>${tuxguitar.api.version}</version><scope>provided</scope></dependency>
    <dependency><groupId>org.junit.jupiter</groupId><artifactId>junit-jupiter</artifactId><version>5.9.2</version><scope>test</scope></dependency>
  </dependencies>
  <build>
    <plugins>
      <plugin><groupId>org.apache.maven.plugins</groupId><artifactId>maven-compiler-plugin</artifactId><version>3.10.1</version></plugin>
      <plugin><groupId>org.apache.maven.plugins</groupId><artifactId>maven-surefire-plugin</artifactId><version>3.2.5</version></plugin>
      <plugin><groupId>org.apache.maven.plugins</groupId><artifactId>maven-jar-plugin</artifactId><version>3.3.0</version>
        <configuration><archive><manifestEntries><TuxGuitar-Target>2.0.1</TuxGuitar-Target><TuxGuitar-Source-Commit>533efa74e6a56bdae28bb776358305607c79cbff</TuxGuitar-Source-Commit></manifestEntries></archive></configuration>
      </plugin>
    </plugins>
  </build>
</project>
